#!/bin/bash
set -e

MIN_SAFE_UPGRADE_VERSION="1.7.0"

check_tmux_sessions() {
    found_session=""
    for sockdir in /tmp/tmux-*; do
        [ -d "$sockdir" ] || continue
        owner=$(stat -c '%U' "$sockdir" 2>/dev/null) || continue
        [ -n "$owner" ] || continue

        for sock in "$sockdir"/*; do
            [ -S "$sock" ] || continue
            sessions=$(runuser -u "$owner" -- tmux -S "$sock" list-sessions -F '#{session_name}' 2>/dev/null || true)
            match=$(echo "$sessions" | grep '^pzsvrtool_' || true)
            if [ -n "$match" ]; then
                found_session="yes"
                return
            fi
        done
    done
}

case "$1" in
    upgrade)
        installed_version="$2"

        if [ -n "$installed_version" ]; then
            if dpkg --compare-versions "$installed_version" lt "$MIN_SAFE_UPGRADE_VERSION"; then
                check_tmux_sessions
                if [ -n "$found_session" ]; then
                    echo "Error: A pzsvrtool-managed server (tmux session) is currently running." >&2
                    echo "Stop the server before upgrading pzsvrtool." >&2
                    exit 1
                fi
            fi
        fi
        ;;
    install)
        # Nothing installed yet — nothing to check
        ;;
esac

#DEBHELPER#

exit 0